# ===================================================================
# ABRAXAS / HTG - Environment Configuration Template
# ===================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# 
# This file is used locally for development and testing.
# Production uses separate environment variables (see deployment docs).
# ===================================================================

# ========================
# Server Configuration
# ========================
NODE_ENV=development
PORT=3001

# CORS allowed origins (comma-separated for multiple domains)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://www.htg.productions

# ========================
# Instagram Graph API
# ========================
# Get these from: https://developers.facebook.com/apps
# 
# Steps:
# 1. Go to https://developers.facebook.com
# 2. Create a new App (Business type)
# 3. Add Instagram Graph API product
# 4. Create an Access Token with instagram_basic,instagram_graph_user_profile,instagram_graph_user_media scopes
# 5. Get your User ID from the same dashboard

INSTAGRAM_USER_ID=your_instagram_user_id_here
INSTAGRAM_TOKEN=your_long_lived_instagram_access_token_here

# ========================
# YouTube Data API
# ========================
# Get these from: https://console.cloud.google.com
#
# Steps:
# 1. Create a new Google Cloud project
# 2. Enable YouTube Data API v3
# 3. Create an API Key (restrict to HTTP referrer)
# 4. Get your Channel ID from YouTube Studio or @username lookup
#
# Find your Channel ID:
# - YouTube Studio > Settings > Channel > Basic Info
# - Or use: https://www.youtube.com/c/YOURHANDLE?sub_confirmation=1
# - Extract from channel URL: youtube.com/channel/CHANNEL_ID

YOUTUBE_CHANNEL_ID=UCyour_channel_id_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# ========================
# TikTok for Developers
# ========================
# Get these from: https://developers.tiktok.com
#
# Steps:
# 1. Register at https://developers.tiktok.com
# 2. Apply for Creator/Business API access
# 3. Create a new app
# 4. Use Client ID and Client Secret below
#
# Note: TikTok API is restrictive. We use embed URLs as fallback.
# If you don't have API access yet, leave these empty ("").

TIKTOK_CLIENT_ID=your_tiktok_client_id_or_leave_empty
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_or_leave_empty
TIKTOK_USER_ID=your_tiktok_user_id_or_leave_empty

# ========================
# Redis Cache Configuration
# ========================
# Local development uses Redis
# Format: redis://[:password]@host:port/database
#
# Local setup (default):
# redis-server  (runs on localhost:6379)
#
# Production (use managed Redis service):
# - Redis Labs
# - AWS ElastiCache
# - DigitalOcean Managed Databases

REDIS_URL=redis://localhost:6379

# ========================
# Social Media Profile URLs
# ========================
# Used for links and embeds throughout the site
# Leave empty ("") to disable links to that platform

INSTAGRAM_PROFILE_URL=https://instagram.com/abraxas.htg
YOUTUBE_PROFILE_URL=https://www.youtube.com/c/YOURCHANNELNAME
TIKTOK_PROFILE_URL=https://www.tiktok.com/@abraxasthemage
SPOTIFY_PROFILE_URL=https://open.spotify.com/artist/24hLqvYHqzi1eL2ZzpjO19
SOUNDCLOUD_PROFILE_URL=https://on.soundcloud.com/uTMdelzf0aAmn2Nx9a

# ========================
# Contact & Email
# ========================
CONTACT_EMAIL=Bookings@htg.productions
SUPPORT_EMAIL=support@htg.productions

# ========================
# Scraper Configuration
# ========================
# How often to run automated scraping (in milliseconds)
# 21600000 = 6 hours
# 3600000 = 1 hour
# 1800000 = 30 minutes

SCRAPER_INTERVAL=21600000

# ========================
# Logging Configuration
# ========================
# Log levels: debug, info, warn, error
LOG_LEVEL=info

# ========================
# Security & Secrets
# ========================
# For production JWT tokens, session secrets, etc.
# Generate secure random strings using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SESSION_SECRET=your_session_secret_here_generate_random_string
JWT_SECRET=your_jwt_secret_here_generate_random_string

# ========================
# Feature Flags
# ========================
# Enable/disable features during development
# true or false (lowercase)

ENABLE_ALBUMS=true
ENABLE_INSTAGRAM_SCRAPER=true
ENABLE_YOUTUBE_SCRAPER=true
ENABLE_TIKTOK_SCRAPER=true
ENABLE_AUTO_SCHEDULER=true

# ========================
# Deployment & Hosting
# ========================
# Use these when deploying to production
# (Vercel, Railway, AWS, DigitalOcean, etc.)

DEPLOYMENT_URL=https://www.htg.productions
API_ENDPOINT=https://api.htg.productions
DATABASE_URL=your_database_url_if_using_postgres_or_similar
